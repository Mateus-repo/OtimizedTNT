{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f": "deny",
      "git push --delete*": "deny",
      "git push * --delete*": "deny",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git rebase *": "ask",
      "rm -rf *": "ask"
    }
  }
}
